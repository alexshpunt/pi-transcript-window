{
  "name": "pi-transcript-window",
  "version": "0.3.1",
  "description": "Pi extension: keep only the latest N TUI messages visible (old entries stay in the session file). Fork of pi-hide-messages adapted for pi 0.84+.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "config.json",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx --yes -p typescript@5.7.3 tsc -p tsconfig.json --noCheck",
    "lint": "npm run build",
    "test:clean": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "pretest": "npm run test:clean",
    "test": "npx --yes -p typescript@5.7.3 tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "posttest": "npm run test:clean",
    "check": "npm run lint && npm run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-tui",
    "coding-agent",
    "hide-messages",
    "restore-messages",
    "chat-history",
    "conversation-history",
    "session-context",
    "context-window",
    "tui",
    "messages",
    "transcript"
  ],
  "author": "newCman1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newCman1/pi-transcript-window.git"
  },
  "bugs": {
    "url": "https://github.com/newCman1/pi-transcript-window/issues"
  },
  "homepage": "https://github.com/newCman1/pi-transcript-window#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3"
  }
}
